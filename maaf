<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Untuk Kamu ❤️</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #ff9a9e, #fad0c4);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.card {
  width: 90%;
  max-width: 430px;
  background: rgba(255,255,255,.95);
  border-radius: 25px;
  padding: 30px 22px;
  text-align: center;
  box-shadow: 0 15px 40px rgba(0,0,0,.2);
  position: relative;
  z-index: 2;
}

.page {
  display: none;
}

.page.active {
  display: block;
  animation: muncul .5s ease;
}

@keyframes muncul {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

h1 {
  color: #ff4f81;
  margin-bottom: 15px;
}

h2 {
  color: #ff5c8a;
}

p {
  color: #555;
  line-height: 1.6;
}

button {
  border: none;
  background: #ff5c8a;
  color: white;
  padding: 13px 22px;
  border-radius: 30px;
  margin: 7px;
  font-size: 15px;
  cursor: pointer;
  transition: .2s;
}

button:hover {
  transform: scale(1.06);
  background: #ff3972;
}

.choice {
  display: block;
  width: 90%;
  margin: 10px auto;
}

#noBtn {
  position: relative;
}

.heart {
  position: fixed;
  color: #ff477e;
  font-size: 25px;
  animation: naik 4s linear forwards;
  z-index: 1;
}

@keyframes naik {
  from {
    transform: translateY(100vh) rotate(0deg);
    opacity: 1;
  }
  to {
    transform: translateY(-10vh) rotate(360deg);
    opacity: 0;
  }
}

.secret {
  font-size: 22px;
  color: #ff477e;
  margin: 20px 0;
}

.small {
  font-size: 13px;
  color: #999;
}
</style>
</head>

<body>

<div class="card">

  <!-- HALAMAN 1 -->
  <div class="page active" id="page1">
    <h1>Haiii Kamu 😏❤️</h1>
    <p>
      Sebelum kamu mendapatkan pesan rahasia dari aku...
      kamu harus melewati beberapa misi kecil dulu 😈
    </p>

    <h2>🎮 Misi 1</h2>
    <p>Menurut kamu, siapa yang paling sering bikin kamu senyum?</p>

    <button class="choice" onclick="benar1()">Aku 😎❤️</button>
    <button class="choice" onclick="salah()">Orang lain 😭</button>
    <button class="choice" onclick="salah()">Tetangga sebelah 🗿</button>

    <p id="hasil1"></p>
  </div>


  <!-- HALAMAN 2 -->
  <div class="page" id="page2">
    <h1>😂 Misi 2</h1>

    <p>
      Sekarang jawab dengan jujur...
    </p>

    <h2>Kenapa aku nggak balas chat?</h2>

    <button class="choice" onclick="salah2()">
      Lagi jalan-jalan 🚶
    </button>

    <button class="choice" onclick="salah2()">
      Lagi main game 🎮
    </button>

    <button class="choice" onclick="benar2()">
      Ketiduran 😴
    </button>

    <p id="hasil2"></p>
  </div>


  <!-- HALAMAN 3 -->
  <div class="page" id="page3">
    <h1>😈 Misi Terakhir</h1>

    <p>
      Klik tombol di bawah untuk membuka pesan rahasia...
    </p>

    <div class="secret">🔒 ❤️ 🔒</div>

    <button onclick="bukaPesan()">
      Buka Pesan Rahasia 💌
    </button>

    <p class="small">
      Tenang... kali ini nggak ada jebakan kok 😇
    </p>
  </div>


  <!-- HALAMAN 4 -->
  <div class="page" id="page4">
    <h1>Maafin Aku Ya 🥺❤️</h1>

    <p>
      Sayanggg... maafin aku ya 😭❤️
    </p>

    <p>
      Aku nggak bermaksud ngilang atau bikin kamu nungguin aku.
      Aku beneran cuma mau rebahan sebentar...
      tapi ternyata aku malah <b>ketiduran 😴</b>.
    </p>

    <p>
      Aku tahu mungkin kamu kesel, kecewa, atau bahkan nungguin aku.
      Maafin aku yaa 🥺
    </p>

    <p>
      Aku janji bakal berusaha supaya nggak bikin kamu nunggu
      lagi gara-gara aku ketiduran.
    </p>

    <h2>
      Jangan marah lama-lama ya ❤️
    </h2>

    <p>
      Sini aku peluk dulu 🤗💕
    </p>

    <h1>❤️ Aku Sayang Kamu ❤️</h1>

    <button onclick="buatHati()">
      Peluk Aku 🤗
    </button>
  </div>

</div>


<script>

function nextPage(number) {
  document.querySelectorAll(".page").forEach(page => {
    page.classList.remove("active");
  });

  document.getElementById("page" + number).classList.add("active");
}

function benar1() {
  document.getElementById("hasil1").innerHTML =
    "Hehe benar 😎❤️ Kamu dapat lanjut!";
  setTimeout(() => nextPage(2), 900);
}

function salah() {
  document.getElementById("hasil1").innerHTML =
    "SALAH! 😭 Coba pilih jawaban yang benar.";
}

function salah2() {
  document.getElementById("hasil2").innerHTML =
    "Hmm... jawaban kamu salah 😂 Coba lagi!";
}

function benar2() {
  document.getElementById("hasil2").innerHTML =
    "NAHH BETUL 😴😂 Kamu boleh lanjut!";
  setTimeout(() => nextPage(3), 900);
}

function bukaPesan() {
  nextPage(4);
  buatHati();
}

function buatHati() {
  for (let i = 0; i < 20; i++) {
    let heart = document.createElement("div");
    heart.className = "heart";
    heart.innerHTML = Math.random() > .5 ? "❤️" : "💕";

    heart.style.left = Math.random() * 100 + "vw";
    heart.style.animationDuration =
      (3 + Math.random() * 3) + "s";

    document.body.appendChild(heart);

    setTimeout(() => {
      heart.remove();
    }, 6000);
  }
}

</script>

</body>
</html>
